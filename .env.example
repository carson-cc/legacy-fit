# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/veltro?sslmode=require
# Needed for Prisma migrations (non-pooled connection). Same host without PgBouncer.
DIRECT_URL=postgresql://user:password@host:5432/veltro?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://yourdomain.com
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com

# ─── AI (required for classify-role + generate-benchmark) ────────────────────
ANTHROPIC_API_KEY=

# ─── Email (required for invites, portal links, password reset) ──────────────
SENDGRID_API_KEY=
SENDGRID_FROM=invites@yourdomain.com

# ─── Sentry (error tracking) ─────────────────────────────────────────────────
# Create a free project at https://sentry.io and copy the DSN here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=   # same value as SENTRY_DSN — exposed to the browser
SENTRY_ORG=               # your Sentry org slug (for source-map uploads)
SENTRY_PROJECT=           # your Sentry project slug

# ─── Cron security ───────────────────────────────────────────────────────────
# Vercel sets this automatically on cron-triggered requests. Set the same value
# locally so you can test /api/cron/prune-event-log manually:
#   curl -H "Authorization: Bearer <value>" http://localhost:3000/api/cron/prune-event-log
# Generate: openssl rand -base64 32
CRON_SECRET=

# ─── Vercel (auto-set on Vercel deployments, not needed locally) ─────────────
# VERCEL_GIT_COMMIT_SHA=  # used by /api/healthz and /status for version display
